@startuml uc-accounts
left to right direction
skinparam packageStyle rectangle

' Human actors
actor "System Administrator" as Admin
actor "Logistics & Resources Officer" as Logistics
actor "Dispatcher" as Dispatcher
actor "Field Commander" as Commander
actor "Field Crew Member" as Crew

rectangle "CrisisSync" {
  usecase "Login" as UC_Login
  usecase "Handle Failed Login" as UC_FailedLogin
  usecase "Lock Account" as UC_Lock
  usecase "Manage Accounts & Permissions" as UC_Accounts
}

Admin -- UC_Login
Logistics -- UC_Login
Dispatcher -- UC_Login
Commander -- UC_Login
Crew -- UC_Login

Admin -- UC_Accounts

UC_FailedLogin ..> UC_Login : <<extend>>
UC_Lock ..> UC_FailedLogin : <<extend>>

@enduml
